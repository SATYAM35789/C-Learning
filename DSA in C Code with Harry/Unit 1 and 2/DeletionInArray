#include<stdio.h>
#include<conio.h>
 // Traversing in array
void Display(int arr, int n ){
    for(int i=0;i<n;i++){
        printf("%d\n", arr[i]);
        
    }
}
// Code for deletion 
void indDeletion(int arr, int size, int index) {
    
    for(int i = index; i< size-2; i++){
        arr[i]= arr[i+1];
    }
    
}
int main() {
    int arr[100] ={7,8,12,27,88};
    int size = 5, element = 45, index=3; // Index at which you  want to delete
    Display(arr ,size);
    indDeletion(arr,size , index); 
    size -=1;
    Display(arr, size);
    return 0;

}