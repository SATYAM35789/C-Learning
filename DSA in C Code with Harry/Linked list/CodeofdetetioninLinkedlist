// Case1. Deleting the first element from the linked list
struct Node *deletefirst(struct Node *head){
    struct Node *ptr = head;
    head = head->next;
    free(ptr);
    return head;

}

// Case2 Deleting the node in between the linked list
struct Node *deleteAtIndex(struct Node *head , int index){
    struct Node *p = head;
    struct Node *q = head->next;
    for (int i = 0; i<index-1; i++){  // Thist loop leave the head node and start  from next
       p = p->next;                   // And this loop is used to move the above pointer to desire position.
       q = q->next;
    }
    p->next = q->next;
    free(q);
    return head;

}
// Case3. Deleting the Last element from the linked list
struct Node *deleteAtLast(struct Node *head){
    struct Node *p = head;
    struct Node *q = head->next;
    while(q->next != NULL){
        p=p->next;
        q=q->next;
    }
    p->next= NULL;
    free(q);
    return head;

}

// Case4 Deleting the node ( address /value of node given not need to traverse)
struct Node *deleteAtValue(struct Node *head , int value){
    struct Node *p = head;
    struct Node *q = head->next;
    while( q->data !=value && q->next !=NULL ) {  
       p = p->next;                   // And this loop is used to move the above pointer to desire position.
       q = q->next;
    }
    if(q->data == value){   // If false true means weare at last
       p->next = q->next;
       free(q);
    }
    return head;

}

