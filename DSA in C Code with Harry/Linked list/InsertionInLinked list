// Insertion in linked list  
// Three cases : 1. Insert at the begining 2. Insert in between 3. Insert at the end. 4. Insert after node.
// We get access by having pointer at head. (A pointer which point to the head).
// ex. struct Node * ptr= (struct Node*)malloc(sizeof(struct Node))
// Case1. step1.   ptr->next=head;
//        step2.   head=ptr;
//        step3.   return head;     Time Complexity O(1)

// Case2.   struct Node * ptr= (struct Node*)malloc(sizeof(struct Node))
//          ptr->next=p->next;
//          p->next=ptr;               Time Complexty: Worst case complexity : O(n)

// Case3.   struct Node * ptr= (struct Node*)malloc(sizeof(struct Node))
//          p->next=ptr;
//          ptr->next=NULL;   Worst case complexity: O(n)

// Case4.   Suppose we have given a ptr (Without traversing)
//          ptr->next=q->next;
//          q->next=ptr;          O(1)

#include<stdio.h>
#include<stdlib.h>

struct Node{
    int data;
    struct Node * next;
};

void Linkelisttraversing(struct Node * ptr)
{
    while(ptr!=NULL)
    {
    printf(" Element:%d\n", ptr->data);
    ptr=ptr->next;
    }
}

// Case1. Insert at the Begining
struct Node * insertAtFirst(struct Node *head, int data){ // A fun which take input as head and data we want to insrt.
    struct Node *ptr = (struct Node*)malloc(sizeof(struct Node));  // A node dynamically stored in the heap.
    ptr->next= head;
    ptr->data= data;
    
    return ptr; // which is now new head. 
}

struct Node * insertAtIndex(struct Node *head, int data, int index){
    struct Node *ptr = (struct Node*)malloc(sizeof(struct Node));
    struct Node *p = head; // I don't want lose the head address.
    int i = 0;

    while(i!=index-1){  // index-1 because I want to go one index before the index we want to insert the new node.
        p = p->next;
        i++;
    }
    ptr->data= data;
    ptr->next = p->next;
    p->next=ptr;
    return head;
}
 
 // Case3. Insert at end
 struct Node * insertAtEnd(struct Node *head, int data){
    struct Node *ptr = (struct Node*)malloc(sizeof(struct Node));
    ptr->data= data;
    struct Node *p = head;
    while(p->next=NULL){
        p=p->next;
    }
    p->next = ptr;
    ptr->next= NULL;
    return head;

 }
  
// Case4. Insert after the node

struct Node * insertAtNode( struct Node *head, struct Node *prevnode, int data){
    struct Node *ptr = (struct Node*)malloc(sizeof(struct Node));
    ptr->data= data;
    
    ptr->next = prevnode->next;
    prevnode->next = ptr;

    return head;

 }


int main(){
    struct Node * head;
    struct Node * second;
    struct Node * third;
    struct Node * fourth;
    // Allocate memory for in the linked list in Heap.
    head = (struct Node*)malloc(sizeof(struct Node));
    second = (struct Node*)malloc(sizeof(struct Node));
    third = (struct Node*)malloc(sizeof(struct Node));
    fourth = (struct Node*)malloc(sizeof(struct Node));

    // linked first and second node.
    head->data = 7;
    head->next= second;

    // linked second and third node.
    second->data = 11;
    second->next= third;

// linked second and third node.
    third->data = 67;
    third->next= fourth;

//  Terminate the list at the fourth element
    fourth->data = 66;
    fourth->next= NULL;

    printf("Linked list before insertion\n");
    Linkelisttraversing(head);

    head = insertAtFirst(head,56);
    printf("Linked list after insertion at Head\n");
    Linkelisttraversing(head); // Traversing after getting new head to the result (case1.)

    head = insertAtIndex(head,56,1);
    printf("Linked list after insertion in between\n");
    Linkelisttraversing(head); 

    printf("Linked list after insertion at end\n");
    head = insertAtEnd(head,78);
    Linkelisttraversing(head);

    head = insertAtNode(head,second,45);
    printf("Linked list after insertion at node\n");
    Linkelisttraversing(head);


    return 0;

}